# Copy to .env and fill in. Never commit .env.
# ── Core ──
DJANGO_DEBUG=0                       # 1 for local development only
SECRET_KEY=                          # required when DEBUG is off
DJANGO_ALLOWED_HOSTS=fkfmeru.co.ke,www.fkfmeru.co.ke
DJANGO_CSRF_TRUSTED_ORIGINS=https://fkfmeru.co.ke,https://www.fkfmeru.co.ke
DJANGO_SECURE_SSL_REDIRECT=1         # set 0 if TLS is terminated and redirected upstream
SITE_URL=https://fkfmeru.co.ke
# SQLITE_PATH=/var/lib/fkf/db.sqlite3
# MEDIA_ROOT=/var/lib/fkf/media
# LOGS_DIR=/var/log/fkf

# ── Email ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FKF Meru League <noreply@fkfmeru.com>
ADMIN_EMAIL=admin@fkfmeru.com

# ── M-Pesa (Daraja) ──
MPESA_ENVIRONMENT=sandbox            # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
